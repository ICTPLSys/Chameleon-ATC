# The same allocator/control path as the acceptance Guest, with disk and NIC drivers.
CONFIG_LOCALVERSION="-chameleon-guest"
CONFIG_SPARSEMEM=y
CONFIG_SLUB=y
CONFIG_CMA=n
CONFIG_MEMORY_HOTPLUG=n
CONFIG_MEMORY_HOTREMOVE=n
CONFIG_DEFERRED_STRUCT_PAGE_INIT=n
CONFIG_ZONE_DEVICE=n
CONFIG_MEMCG=n
CONFIG_LRU_GEN=n
CONFIG_LLFREE=y
CONFIG_VIRTIO_BALLOON=n
CONFIG_VIRTIO_LLFREE_BALLOON=y
CONFIG_CHAMELEON=y
CONFIG_CHAMELEON_POLICY=y
CONFIG_CHAMELEON_TEST=y
CONFIG_DEBUG_VM=y
CONFIG_DEBUG_LIST=y
CONFIG_GUP_TEST=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_MEM_SOFT_DIRTY=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_SMP=y
CONFIG_NUMA=n
CONFIG_HOTPLUG_CPU=n
