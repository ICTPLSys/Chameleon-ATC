# Native Host allocator; private KVM/PEBS plus VFIO with a translated IOMMU.
CONFIG_LOCALVERSION="-chameleon-host"
CONFIG_LLFREE=n
CONFIG_VIRTIO_LLFREE_BALLOON=n
CONFIG_CHAMELEON=n
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_IRQ_REMAP=y
CONFIG_AMD_IOMMU=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_VFIO_GROUP=y
CONFIG_VFIO_CONTAINER=y
CONFIG_VFIO_IOMMU_TYPE1=m
CONFIG_VFIO_NOIOMMU=n
CONFIG_IOMMUFD=m
CONFIG_TUN=m
CONFIG_BRIDGE=m
CONFIG_VHOST_NET=m
CONFIG_NET_SWITCHDEV=y
CONFIG_MLX5_ESWITCH=y
CONFIG_BONDING=m
CONFIG_VLAN_8021Q=m
CONFIG_IXGBE=m
CONFIG_I40E=m
CONFIG_ICE=m
CONFIG_IGB=m
CONFIG_E1000E=m
CONFIG_SCSI_MEGARAID_SAS=m
CONFIG_SCSI_MPT3SAS=m
CONFIG_MD=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_RAID1=m
CONFIG_MD_RAID10=m
CONFIG_MD_RAID456=m
CONFIG_FTRACE=y
CONFIG_GUP_TEST=y
