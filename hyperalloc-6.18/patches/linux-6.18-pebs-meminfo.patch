@@ -627,11 +631,16 @@ static void intel_pmu_init(struct kvm_vcpu *vcpu)
 	lbr_desc->records.nr = 0;
 	lbr_desc->event = NULL;
 	lbr_desc->msr_passthrough = false;
+	if (vcpu->kvm->arch.hyperalloc_pebs_meminfo)
+		pmu->pebs_data_cfg = PEBS_DATACFG_MEMINFO;
 }
 
 static void intel_pmu_reset(struct kvm_vcpu *vcpu)
 {
 	intel_pmu_release_guest_lbr_event(vcpu);
+	/* RESET and CPUID/PERF_CAPABILITIES refresh cannot change the layout. */
+	if (vcpu->kvm->arch.hyperalloc_pebs_meminfo)
+		vcpu_to_pmu(vcpu)->pebs_data_cfg = PEBS_DATACFG_MEMINFO;
 }
 
