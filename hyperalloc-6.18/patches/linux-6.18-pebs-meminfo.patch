diff --git a/arch/x86/kvm/pmu.c b/arch/x86/kvm/pmu.c
index 487ad19..c93d5c1 100644
--- a/arch/x86/kvm/pmu.c
+++ b/arch/x86/kvm/pmu.c
@@ -29,6 +29,30 @@
 /* Unadultered PMU capabilities of the host, i.e. of hardware. */
 static struct x86_pmu_capability __read_mostly kvm_host_pmu;
 
+bool kvm_pmu_has_hyperalloc_pebs_meminfo(void)
+{
+	static const struct x86_cpu_id cpus[] = {
+		X86_MATCH_VFM(INTEL_ICELAKE_X, NULL),
+		X86_MATCH_VFM(INTEL_ICELAKE_D, NULL),
+		{}
+	};
+	u64 perf_cap;
+
+	/*
+	 * On ICX/D, perf sets ds_pebs from X86_FEATURE_PEBS, loads intel_cap
+	 * directly from this MSR, and sets pebs_no_isolation only for PMU v4
+	 * and earlier.  The older-model isolation quirks do not apply here.
+	 * Use the existing perf capability ABI so a matching KVM module can
+	 * be loaded without replacing the host perf implementation.
+	 */
+	return enable_pmu && tdp_enabled && x86_match_cpu(cpus) &&
+		kvm_host_pmu.version > 4 && kvm_host_pmu.pebs_ept &&
+		boot_cpu_has(X86_FEATURE_PEBS) && boot_cpu_has(X86_FEATURE_PDCM) &&
+		!rdmsrq_safe(MSR_IA32_PERF_CAPABILITIES, &perf_cap) &&
+		(perf_cap & PERF_CAP_PEBS_BASELINE) &&
+		(perf_cap & PERF_CAP_PEBS_FORMAT) == (4ULL << 8);
+}
+
 /* KVM's PMU capabilities, i.e. the intersection of KVM and hardware support. */
 struct x86_pmu_capability __read_mostly kvm_pmu_cap;
 EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_pmu_cap);
@@ -1130,6 +1154,12 @@ int kvm_vm_ioctl_set_pmu_event_filter(struct kvm *kvm, void __user *argp)
 		goto cleanup;
 
 	mutex_lock(&kvm->lock);
+	/* Serialize both opt-in directions; adaptive sampling defeats filters. */
+	if (kvm->arch.hyperalloc_pebs_meminfo) {
+		mutex_unlock(&kvm->lock);
+		r = -EINVAL;
+		goto cleanup;
+	}
 	filter = rcu_replace_pointer(kvm->arch.pmu_event_filter, filter,
 				     mutex_is_locked(&kvm->lock));
 	mutex_unlock(&kvm->lock);
