 2 files changed, 19 insertions(+)

diff --git a/include/linux/vmstat.h b/include/linux/vmstat.h
index c287998..b5d03ef 100644
--- a/include/linux/vmstat.h
+++ b/include/linux/vmstat.h
@@ -176,6 +176,21 @@ static inline void node_page_state_add(long x, struct pglist_data *pgdat,
 static inline unsigned long global_zone_page_state(enum zone_stat_item item)
 {
 	long x = atomic_long_read(&vm_zone_stat[item]);
+#ifdef CONFIG_LLFREE
+	/*
+	 * HyperAlloc changes per-zone free counters from QEMU during hard
+	 * reclaim/return. Its shared ABI does not publish vm_zone_stat, so
+	 * aggregate those atomically readable counters for this item only.
+	 * Per-CPU differentials retain the normal vmstat batching semantics.
+	 */
+	if (item == NR_FREE_PAGES) {
+		struct zone *zone;
+
+		x = 0;
+		for_each_populated_zone(zone)
+			x += atomic_long_read(&zone->vm_stat[NR_FREE_PAGES]);
+	}
+#endif
 #ifdef CONFIG_SMP
 	if (x < 0)
 		x = 0;
