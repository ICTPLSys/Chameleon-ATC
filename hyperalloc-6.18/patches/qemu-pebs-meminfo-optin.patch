From 90014b8e1f3d7afb3cd27c919571b4829a584ca6 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sun, 20 Sep 2026 01:15:42 +0800
Subject: [PATCH] Add explicit per-VM opt-in for restricted PEBS MEMINFO ABI

---
 docs/hyperalloc-pebs-meminfo.md | 34 +++++++++++++++++++++++++++
 include/sysemu/kvm_int.h        |  1 +
 linux-headers/linux/kvm.h       |  3 +++
 target/i386/kvm/kvm.c           | 41 +++++++++++++++++++++++++++++++++
 4 files changed, 79 insertions(+)
 create mode 100644 docs/hyperalloc-pebs-meminfo.md

diff --git a/docs/hyperalloc-pebs-meminfo.md b/docs/hyperalloc-pebs-meminfo.md
new file mode 100644
index 0000000..3855fbb
--- /dev/null
+++ b/docs/hyperalloc-pebs-meminfo.md
@@ -0,0 +1,34 @@
+# HyperAlloc restricted PEBS MEMINFO
+
+Enable the private host/guest ABI explicitly:
+
+```sh
+qemu-system-x86_64 \
+  -accel kvm,hyperalloc-pebs-meminfo=on \
+  -cpu host,migratable=off,pmu=on \
+  ...
+```
+
+The accelerator property defaults to `off`. Before creating any vCPU, QEMU
+checks `KVM_CAP_HYPERALLOC_PEBS_MEMINFO` (`0x48410001`) and enables it with
+`KVM_ENABLE_CAP`, `args[0] = 1`, and other arguments zero. A host without
+the matching capability or a rejected enable request causes startup to fail.
+There is no fallback that silently ignores this explicit request.
+
+The matching host kernel exposes the guest read-only ABI identification MSR
+`0x4b564d10`, value `1`. That ABI is restricted to fixed PEBS basic + MEMINFO
+records and eligible general-purpose counters; it is not general adaptive
+PEBS. QEMU does not set the architectural PEBS BASELINE bit or advertise
+additional architectural PMU capabilities. The host enforces the allowed
+record fields, counter types, event policy and per-VM authorization. The
+matching guest kernel recognizes and consumes the private record ABI.
+
+Use a single KVM accelerator for this mode. Explicitly configuring a separate
+accelerator fallback follows QEMU's normal fallback semantics and does not
+enable this KVM-specific ABI in another accelerator.
+
+On the unmodified physical host, the three startup cases were checked: the
+default and explicit `off` both start with KVM, while explicit `on` exits
+with the missing-capability diagnostic. These checks do not establish that
+MEMINFO address samples work; that requires the patched host kernel and
+guest runtime sampling validation on capable physical hardware.
diff --git a/include/sysemu/kvm_int.h b/include/sysemu/kvm_int.h
index fd84639..899da8b 100644
--- a/include/sysemu/kvm_int.h
+++ b/include/sysemu/kvm_int.h
@@ -116,6 +116,7 @@ struct KVMState
     struct KVMDirtyRingReaper reaper;
     NotifyVmexitOption notify_vmexit;
     uint32_t notify_window;
+    bool hyperalloc_pebs_meminfo;
     uint32_t xen_version;
     uint32_t xen_caps;
     uint16_t xen_gnttab_max_frames;
diff --git a/linux-headers/linux/kvm.h b/linux-headers/linux/kvm.h
index 0d74ee9..cb50721 100644
--- a/linux-headers/linux/kvm.h
+++ b/linux-headers/linux/kvm.h
@@ -1189,6 +1189,9 @@ struct kvm_ppc_resize_hpt {
 #define KVM_CAP_ARM_EAGER_SPLIT_CHUNK_SIZE 228
 #define KVM_CAP_ARM_SUPPORTED_BLOCK_SIZES 229
 
+/* HyperAlloc private ABI: fixed PEBS basic + MEMINFO records, opt-in per VM. */
+#define KVM_CAP_HYPERALLOC_PEBS_MEMINFO 0x48410001
+
 #ifdef KVM_CAP_IRQ_ROUTING
 
 struct kvm_irq_routing_irqchip {
diff --git a/target/i386/kvm/kvm.c b/target/i386/kvm/kvm.c
index 4ce8055..13fe0dc 100644
--- a/target/i386/kvm/kvm.c
+++ b/target/i386/kvm/kvm.c
@@ -2522,6 +2522,23 @@ int kvm_arch_init(MachineState *ms, KVMState *s)
     struct utsname utsname;
     Error *local_err = NULL;
 
+    /* Must precede vCPU creation; this changes a per-VM KVM contract. */
+    if (s->hyperalloc_pebs_meminfo) {
+        if (kvm_check_extension(s, KVM_CAP_HYPERALLOC_PEBS_MEMINFO) <= 0) {
+            error_report("HyperAlloc PEBS MEMINFO requested, but host KVM lacks "
+                         "KVM_CAP_HYPERALLOC_PEBS_MEMINFO (0x48410001); "
+                         "a matching patched host kernel is required");
+            return -ENOTSUP;
+        }
+        ret = kvm_vm_enable_cap(s, KVM_CAP_HYPERALLOC_PEBS_MEMINFO, 0, 1);
+        if (ret < 0) {
+            error_report("Cannot enable HyperAlloc PEBS MEMINFO: %s",
+                         strerror(-ret));
+            return ret;
+        }
+        info_report("HyperAlloc PEBS MEMINFO ABI 1 enabled for this VM");
+    }
+
     /*
      * Initialize SEV context, if required
      *
@@ -5780,8 +5797,32 @@ static void kvm_arch_set_xen_evtchn_max_pirq(Object *obj, Visitor *v,
     s->xen_evtchn_max_pirq = value;
 }
 
+static bool kvm_arch_get_hyperalloc_pebs_meminfo(Object *obj, Error **errp)
+{
+    return KVM_STATE(obj)->hyperalloc_pebs_meminfo;
+}
+
+static void kvm_arch_set_hyperalloc_pebs_meminfo(Object *obj, bool value,
+                                               Error **errp)
+{
+    KVMState *s = KVM_STATE(obj);
+
+    if (s->fd != -1) {
+        error_setg(errp, "Cannot set hyperalloc-pebs-meminfo after the "
+                   "accelerator has been initialized");
+        return;
+    }
+    s->hyperalloc_pebs_meminfo = value;
+}
+
 void kvm_arch_accel_class_init(ObjectClass *oc)
 {
+    object_class_property_add_bool(oc, "hyperalloc-pebs-meminfo",
+                                  kvm_arch_get_hyperalloc_pebs_meminfo,
+                                  kvm_arch_set_hyperalloc_pebs_meminfo);
+    object_class_property_set_description(oc, "hyperalloc-pebs-meminfo",
+        "Opt in to the HyperAlloc fixed PEBS MEMINFO ABI (default: off)");
+
     object_class_property_add_enum(oc, "notify-vmexit", "NotifyVMexitOption",
                                    &NotifyVmexitOption_lookup,
                                    kvm_arch_get_notify_vmexit,
-- 
2.34.1

