+int
+save_csr_graph(FILE *stream)
+{
+  int64_t shape[2] = {nv, XOFF(nv) + MINVECT_SIZE};
+  return cache_io(stream, shape, sizeof(shape), 1) ||
+    cache_io(stream, xoff, (2*nv+2)*sizeof(*xoff), 1) ||
+    cache_io(stream, xadjstore, shape[1]*sizeof(*xadjstore), 1) ? -1 : 0;
+}
+
+int
+load_csr_graph(FILE *stream, int64_t vertex_limit, int64_t edge_limit)
+{
+  int64_t shape[2], k;
+  if (cache_io(stream, shape, sizeof(shape), 0)) return -1;
+  if (shape[0] <= 0 || shape[0] > vertex_limit ||
+      shape[1] < MINVECT_SIZE ||
+      shape[1] > 2*edge_limit + 2*vertex_limit + MINVECT_SIZE) {
+    errno = EINVAL;
+    return -1;
+  }
+  nv = shape[0]; maxvtx = nv-1;
+  if (alloc_graph(edge_limit)) return -1;
+  xadjstore = xmalloc_large_ext(shape[1]*sizeof(*xadjstore));
+  if (!xadjstore) { xfree_large(xoff); return -1; }
+  xadj = &xadjstore[MINVECT_SIZE];
+  if (cache_io(stream, xoff, (2*nv+2)*sizeof(*xoff), 0) ||
+      cache_io(stream, xadjstore, shape[1]*sizeof(*xadjstore), 0)) {
+    free_graph(); return -1;
+  }
+  if (XOFF(nv) != shape[1]-MINVECT_SIZE) goto invalid;
+  for (k = 0; k < nv; ++k)
+    if (XOFF(k) < 0 || XOFF(k) > XENDOFF(k) ||
+        XENDOFF(k) > XOFF(k+1) || XOFF(k+1) > XOFF(nv)) goto invalid;
+  return 0;
+invalid:
+  errno = EINVAL; free_graph(); return -1;
+}
